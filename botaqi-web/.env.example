##############################################
# Botaqi Frontend Environment Configuration  #
##############################################
# Copy this file to .env and supply values.
# DO NOT commit .env to git. Use .gitignore.

###############################################
# PUBLIC (VITE_*) — Browser-safe only       #
###############################################

# Firebase (public config)
VITE_FIREBASE_API_KEY=REPLACE_WITH_YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_YOUR_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=REPLACE_WITH_YOUR_FIREBASE_MEASUREMENT_ID

# App runtime
VITE_APP_BASE_URL=http://localhost:5173

###############################################
# SERVER-ONLY (Vercel Functions / Build)    #
###############################################
# DO NOT expose to browser. Add to Vercel   #
# Settings > Environment Variables, NOT     #
# commit to repo.                            #

# Firebase Admin (service account)
# Base64-encoded service account JSON
FIREBASE_ADMIN_KEY=REPLACE_WITH_YOUR_BASE64_FIREBASE_ADMIN_KEY

# OpenAI API (server-side generation, if needed)
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_OPENAI_KEY

# Analytics & Rate-Limit API Key
LOGBLOCKED_API_KEY=REPLACE_WITH_YOUR_LOGBLOCKED_API_KEY
