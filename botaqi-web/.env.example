# Botaqi (.env.example) — DO NOT COMMIT REAL SECRETS
# Copy to .env.local for local dev OR set values in Vercel (server secrets only in Vercel)

# -----------------------
# Client / Public (safe to be client-visible)
# -----------------------
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_CLIENT_API_KEY`
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=botaqiy-arabic-learning
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_BUCKET.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_ID
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=REPLACE_WITH_MEASUREMENT_ID

# Feature flags (client-visible)
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_FEATURE_RTL=true

# -----------------------
# Server / Secret (SET THESE IN VERCEL OR OTHER SECRET MANAGER)
# -----------------------
# Base64-encoded Firebase service account JSON (used by server API routes)
FIREBASE_ADMIN_KEY=REPLACE_WITH_BASE64_SERVICE_ACCOUNT_JSON

# OpenAI (server-side only)
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY

# App-specific server API key used by internal endpoints (e.g., logBlocked)
LOGBLOCKED_API_KEY=REPLACE_WITH_SECURE_TOKEN

# Vercel: token for scripted API usage (store in Vercel/CI only)
VERCEL_TOKEN=REPLACE_WITH_VERCEL_TOKEN
VERCEL_PROJECT_ID=REPLACE_WITH_VERCEL_PROJECT_ID

# Sentry: DSN for client + server
SENTRY_DSN=REPLACE_WITH_SENTRY_DSN

# -----------------------
# Local-only & Emulators (optional; keep out of prod)
# -----------------------
# Uncomment for local Firestore emulator usage during development
# FIRESTORE_EMULATOR_HOST=localhost:8081

# -----------------------
# NOTES
# -----------------------
# - Never commit a real .env file. Keep this example in repo.
# - Put all server secrets (FIREBASE_ADMIN_KEY, OPENAI_API_KEY, LOGBLOCKED_API_KEY,
#   VERCEL_TOKEN, SENTRY_DSN) into Vercel (or other secret manager) before deployment.
# - Ensure FIREBASE_ADMIN_KEY is base64(serviceAccountJson) if deploy scripts expect base64.
# - See botaqi-web/DEPLOYMENT_CHECKLIST.md for exact formats and validation commands.